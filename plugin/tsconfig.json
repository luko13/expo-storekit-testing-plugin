{
  "extends": "expo-module-scripts/tsconfig.plugin",
  "compilerOptions": {
    "declaration": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "build",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["**/__tests__/**"]
}
